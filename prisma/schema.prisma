generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Country {
  NG
  KE
  GH
  TZ
  SN
}

enum WorkspaceType {
  Brand
  Agency
}

enum WorkspaceStatus {
  pending
  approved
  declined
}

enum Role {
  Owner
  Manager
  Viewer
}

enum Placement {
  card
  featured
  video
  splash
}

enum RedeemMethod {
  code
  link
}

enum CampaignStatus {
  draft
  review
  live
  paused
  rejected
  scheduled
  ended
}

enum SharerType {
  Root
  Channel
  Consumer
}

enum ShareVia {
  whatsapp
  sms
  x
  copy
  other
  facebook
}

enum LinkEventType {
  Open
  Claim
  DetailsLeft
}

enum ChannelEventType {
  Impression
  Open
  Claim
  Share
  ShareOpen
  ShareClaim
}

enum ReviewTarget {
  Workspace
  Campaign
}

enum ReviewVerb {
  Approve
  Reject
  Decline
}

enum RejectReason {
  misleading_terms
  not_available
  broken_link
  prohibited_category
  missing_licence
  creative_standards
}

enum InvoiceStatus {
  open
  due
  paid
}

enum LedgerKind {
  delivery
  reward
  payment
  credit
  refund
}

enum PayoutStatus {
  queued
  sent
  held
  blocked
  rejected
}

enum NotificationKind {
  approved
  credit
  pace
  ended
  weekly
  review
  system
}

enum CreditRequestStatus {
  open
  approved
  dismissed
}

enum RevisionStatus {
  review
  rejected
  applied
}

enum StatementStatus {
  open
  paid
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String
  isGlobalAdmin    Boolean           @default(false)
  // Demo data (Prompt 9): true only for the people the seed makes; `npm run demo:remove` deletes these and nothing else.
  demo             Boolean           @default(false)
  createdAt        DateTime          @default(now())
  memberships      WorkspaceMember[]
  reviews          ReviewAction[]
  auditEvents      AuditEvent[]
  // The campaigns this user created (Campaign.createdById).
  campaignsCreated Campaign[]
}

model Workspace {
  id                       String            @id @default(cuid())
  name                     String
  type                     WorkspaceType
  country                  Country
  status                   WorkspaceStatus   @default(pending)
  declineReason            String?
  createdAt                DateTime          @default(now())
  members                  WorkspaceMember[]
  campaigns                Campaign[]
  creditLimitCents         Int               @default(50000)
  registrationNumber       String?
  accountManager           String            @default("Obinna A.")
  termsDays                Int               @default(14)
  approvedAt               DateTime?
  rewardMaxPerSharerPerDay Int               @default(5)
  rewardCapPct             Int               @default(20)
  pointsPerShare           Int               @default(10)
  // Demo data (Prompt 9): true only for the seed's workspaces, which the console marks with a grey "Demo" pill.
  demo                     Boolean           @default(false)
  invitations              Invitation[]
  ledger                   LedgerEntry[]
  invoices                 Invoice[]
  creditRequests           CreditRequest[]
  payouts                  RewardPayout[]
}

model WorkspaceMember {
  userId      String
  workspaceId String
  role        Role      @default(Owner)
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@id([userId, workspaceId])
}

model Channel {
  id                    String                @id @default(cuid())
  key                   String                @unique
  name                  String
  apiKeyHash            String
  isLive                Boolean               @default(false)
  countries             Country[]
  shareLinks            ShareLink[]
  events                ChannelEvent[]
  batches               ChannelBatch[]
  previousKeyHash       String?
  previousKeyValidUntil DateTime?
  keyCreatedAt          DateTime              @default(now())
  rateCards             RateCard[]
  shares                ChannelShare[]
  statements            SettlementStatement[]
  claimCodes            ClaimCode[]
}

model Campaign {
  id               String             @id @default(cuid())
  workspaceId      String
  name             String
  brand            String
  country          Country
  category         String
  headline         String
  description      String
  creativeImageKey String?
  tileColor        String?
  placement        Placement
  redeemMethod     RedeemMethod
  claimCode        String? // Legacy (slice 1): no form sets it; codes are issued per claim (ClaimCode). Drop after the schema freeze.
  linkUrl          String?
  budgetUsd        Int
  startsAt         DateTime
  endsAt           DateTime
  shareRewardLabel String
  status           CampaignStatus     @default(draft)
  rejectReason     String?
  submittedAt      DateTime?
  decidedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  workspace        Workspace          @relation(fields: [workspaceId], references: [id])
  shareLinks       ShareLink[]
  channelEvents    ChannelEvent[]
  creativeVideoKey String?
  ageGated         Boolean            @default(false)
  rewardLocal      Int                @default(0)
  rewardCapPct     Int                @default(20)
  cpmCents         Int?
  fxPerUsd         Decimal?
  rejectReasonCode RejectReason?
  endedAt          DateTime?
  pausedBy         String? // 'credit' | 'user' | null
  version          Int                @default(1)
  revisions        CampaignRevision[]
  payouts          RewardPayout[]
  claimCodes       ClaimCode[]
  ledger           LedgerEntry[]
  points           PointsLedger[]
  // Who created it: the member who submitted the New campaign form (the seed: the person who submits it). Null for
  // campaigns from before the column, and when that user is deleted; the campaign stays either way.
  createdById      String?
  createdBy        User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status, country])
  @@index([createdById])
}

model ReviewAction {
  id         String       @id @default(cuid())
  targetType ReviewTarget
  targetId   String
  action     ReviewVerb
  reason     String?
  byUserId   String
  at         DateTime     @default(now())
  by         User         @relation(fields: [byUserId], references: [id])

  @@index([targetType, targetId])
}

model ShareLink {
  id              String         @id @default(cuid())
  code            String         @unique
  campaignId      String
  channelId       String
  parentId        String?
  depth           Int
  sharerType      SharerType
  sharerSessionId String?
  consumerId      String?
  via             ShareVia?
  createdAt       DateTime       @default(now())
  campaign        Campaign       @relation(fields: [campaignId], references: [id])
  channel         Channel        @relation(fields: [channelId], references: [id])
  parent          ShareLink?     @relation("LinkTree", fields: [parentId], references: [id])
  children        ShareLink[]    @relation("LinkTree")
  consumer        Consumer?      @relation(fields: [consumerId], references: [id])
  events          LinkEvent[]
  payouts         RewardPayout[]

  @@unique([parentId, consumerId])
  @@index([campaignId, channelId])
  @@index([parentId])
  // A browser's own links (the friend's number at claim time) and a number's links (phone reuse).
  @@index([sharerSessionId])
  @@index([consumerId])
}

model Consumer {
  id         String      @id @default(cuid())
  phone      String      @unique
  country    Country
  name       String?
  createdAt  DateTime    @default(now())
  shareLinks ShareLink[]
}

model LinkEvent {
  id        String        @id @default(cuid())
  linkId    String
  type      LinkEventType
  visitorId String
  ipHash    String
  userAgent String
  deduped   Boolean       @default(false)
  at        DateTime      @default(now())
  link      ShareLink     @relation(fields: [linkId], references: [id])

  @@index([linkId, type])
  // A browser's claims (phone reuse).
  @@index([visitorId])
}

model ChannelEvent {
  id         String           @id @default(cuid())
  channelId  String
  campaignId String
  type       ChannelEventType
  sessionId  String
  linkCode   String?
  at         DateTime
  dedupeKey  String
  channel    Channel          @relation(fields: [channelId], references: [id])
  campaign   Campaign         @relation(fields: [campaignId], references: [id])

  @@unique([channelId, dedupeKey])
  @@index([campaignId, type])
  // Recent activity: a campaign's events of a type, newest first from a cursor.
  @@index([campaignId, type, at])
}

model ChannelBatch {
  id         String   @id @default(cuid())
  channelId  String
  key        String
  accepted   Int
  deduped    Int
  ignored    Int
  receivedAt DateTime @default(now())
  channel    Channel  @relation(fields: [channelId], references: [id])

  @@unique([channelId, key])
}

model Invitation {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role
  token       String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String?
  workspaceId String?
  kind        NotificationKind
  title       String
  detail      String?
  href        String?
  createdAt   DateTime         @default(now())
  readAt      DateTime?

  @@index([userId, createdAt])
}

model NotificationPref {
  userId      String
  workspaceId String
  kind        NotificationKind
  enabled     Boolean

  @@id([userId, workspaceId, kind])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String? // null: the daily job (audit's SYSTEM_ACTOR)
  action      String
  targetType  String
  targetId    String
  workspaceId String?
  before      Json?
  after       Json?
  at          DateTime @default(now())
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, at])
  @@index([targetType, targetId])
}

model CreditRequest {
  id            String              @id @default(cuid())
  workspaceId   String
  requestedById String
  status        CreditRequestStatus @default(open)
  note          String?
  createdAt     DateTime            @default(now())
  decidedAt     DateTime?
  decidedById   String?
  workspace     Workspace           @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, status])
}

model CampaignRevision {
  id               String         @id @default(cuid())
  campaignId       String
  data             Json
  status           RevisionStatus @default(review)
  rejectReasonCode RejectReason?
  rejectReason     String?
  submittedAt      DateTime       @default(now())
  decidedAt        DateTime?
  campaign         Campaign       @relation(fields: [campaignId], references: [id])
  cpmCents         Int? // Phoenix's rate for a new placement, priced at submission; null keeps the campaign's

  @@index([campaignId, status])
}

model LedgerEntry {
  id          String     @id @default(cuid())
  workspaceId String
  at          DateTime   @default(now())
  description String
  amountCents Int
  kind        LedgerKind
  campaignId  String?
  invoiceId   String?
  dedupeKey   String?    @unique
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
  campaign    Campaign?  @relation(fields: [campaignId], references: [id])
  invoice     Invoice?   @relation(fields: [invoiceId], references: [id])

  @@index([workspaceId, at])
}

model Invoice {
  id          String        @id @default(cuid())
  workspaceId String
  number      String        @unique
  period      DateTime
  amountCents Int
  fxPerUsd    Decimal
  country     Country // the billing country at issue: the invoice's currency and month, whatever the workspace's now
  status      InvoiceStatus @default(open)
  issuedAt    DateTime
  dueAt       DateTime
  paidAt      DateTime?
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  entries     LedgerEntry[]

  @@index([workspaceId, period])
}

model RateCard {
  id            String    @id @default(cuid())
  channelId     String
  country       Country
  placement     Placement
  cpmCents      Int
  effectiveFrom DateTime
  channel       Channel   @relation(fields: [channelId], references: [id])

  @@index([channelId, country, placement, effectiveFrom])
}

model MarketFx {
  id            String   @id @default(cuid())
  country       Country
  fxPerUsd      Decimal
  effectiveFrom DateTime

  @@index([country, effectiveFrom])
}

model ChannelShare {
  id            String   @id @default(cuid())
  channelId     String
  share         Decimal
  effectiveFrom DateTime
  channel       Channel  @relation(fields: [channelId], references: [id])

  @@index([channelId, effectiveFrom])
}

model SettlementStatement {
  id          String          @id @default(cuid())
  channelId   String
  period      DateTime
  amountCents Int
  status      StatementStatus @default(open)
  paidAt      DateTime?
  channel     Channel         @relation(fields: [channelId], references: [id])

  @@unique([channelId, period])
}

model RewardPayout {
  id               String       @id @default(cuid())
  campaignId       String
  workspaceId      String
  shareLinkId      String
  sharerConsumerId String?
  sharerSessionId  String?
  claimEventKey    String       @unique
  amountLocal      Int
  amountCents      Int
  status           PayoutStatus
  // no_phone | same_device | cap_per_sharer | platform_cap | phone_reuse | cap | manual
  reason           String?
  createdAt        DateTime     @default(now())
  sentAt           DateTime?
  campaign         Campaign     @relation(fields: [campaignId], references: [id])
  workspace        Workspace    @relation(fields: [workspaceId], references: [id])
  shareLink        ShareLink    @relation(fields: [shareLinkId], references: [id])

  @@index([campaignId, status])
  // A sharer's payouts today (the per-sharer caps).
  @@index([sharerConsumerId, createdAt])
}

model PointsLedger {
  id              String   @id @default(cuid())
  consumerId      String?
  sharerSessionId String?
  campaignId      String
  points          Int
  createdAt       DateTime @default(now())
  campaign        Campaign @relation(fields: [campaignId], references: [id])
}

model AggregatorAccount {
  id           String @id @default("reloadly")
  balanceCents Int
}

model AggregatorTopup {
  id          String   @id @default(cuid())
  amountCents Int
  byUserId    String
  at          DateTime @default(now())
}

model FraudRule {
  key     String  @id
  label   String
  action  String
  enabled Boolean
}

model ClaimCode {
  id         String   @id @default(cuid())
  // Unique per campaign, not globally: a global space of 32^4 codes could be exhausted by cheap claims.
  code       String
  campaignId String
  channelId  String
  sessionId  String
  day        DateTime // UTC date of issue
  validUntil DateTime
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  channel    Channel  @relation(fields: [channelId], references: [id])

  @@unique([campaignId, channelId, sessionId, day])
  @@unique([campaignId, code])
}

model JobRun {
  id    String   @id @default(cuid())
  name  String
  day   DateTime
  ranAt DateTime @default(now())

  @@unique([name, day])
}
