{
  "name": "oshofree",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:test": "dotenv -o -e .env.test -v NEXT_DIST_DIR=.next-e2e -- next dev -p 3101",
    "build": "next build",
    "start": "next start -p 3100",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "dotenv -o -e .env.test -- sh -c 'prisma migrate deploy && tsx scripts/db-truncate.ts && SEED_FORCE=1 tsx prisma/seed.ts && playwright test'",
    "db:migrate": "dotenv -- prisma migrate dev",
    "db:seed": "dotenv -- tsx prisma/seed.ts",
    "db:reset": "dotenv -- prisma migrate reset --force",
    "job:daily": "dotenv -- tsx scripts/daily.ts",
    "docker:up": "docker compose up -d",
    "pretest": "dotenv -o -e .env.test -- prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.6",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.72.0",
    "next": "15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
