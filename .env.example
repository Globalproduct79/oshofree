DATABASE_URL=postgresql://oshofree:oshofree@localhost:5433/oshofree
AUTH_SECRET=dev-only-change-me
APP_URL=http://localhost:3100
UPLOAD_DIR=./uploads
DEMO_WALL=1
DEMO_CHANNEL_KEY=phx_dev_oshofree
IP_HASH_SALT=dev-salt
AUTH_TRUST_HOST=true
# "Simulate a day" and "Run daily job" for Global: 1 on a demo machine, unset in production.
DEMO_CONTROLS=
# Optional: the share of the prototype's volumes the seed generates, above 0 and at most 1 (default 1).
SEED_SCALE=
# Production only, for `npm run bootstrap` (README, Deploy checklist); the seed makes the demo's users and key.
# The Global user to create or keep. The password must be at least 8 characters and is never printed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Phoenix's API key. Leave it empty and the first bootstrap makes one and prints it once.
PHOENIX_CHANNEL_KEY=
