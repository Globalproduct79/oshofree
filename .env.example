# Copy to .env (`cp .env.example .env`). Every value here is a development default; none is a real secret.
# .env is git-ignored. Never commit it, and never paste a production value into this file.

# The database. One structure everywhere: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#   development  postgresql://oshofree:oshofree@localhost:5433/oshofree        (docker-compose.yml)
#   tests        postgresql://oshofree:oshofree@localhost:5433/oshofree_test   (.env.test, fixed)
#   production   postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
# The test runner refuses any database not named *_test, so keep that suffix for test databases only.
DATABASE_URL=postgresql://oshofree:oshofree@localhost:5433/oshofree

# Signs the session cookie. Production: a random string of 32 or more characters (`openssl rand -base64 32`).
AUTH_SECRET=dev-only-change-me
AUTH_TRUST_HOST=true

# The origin share, invite and creative links are built from. Production: the public https:// origin.
APP_URL=http://localhost:3100

# Where uploaded creatives are written (git-ignored). The seed copies its sample JPGs here.
UPLOAD_DIR=./uploads

# Salts the visitor IP hash. Production refuses to serve a landing page without one of 16+ characters.
IP_HASH_SALT=dev-salt

# The demo wall at /wall: 1 on a development or demo machine, unset in production.
DEMO_WALL=1
# The seed's Phoenix channel key. Development only; production keys come from `npm run bootstrap`.
DEMO_CHANNEL_KEY=phx_dev_oshofree
# "Simulate a day" and "Run daily job" for Global: 1 on a demo machine, unset in production.
DEMO_CONTROLS=
# Optional: the share of the prototype's volumes the seed generates, above 0 and at most 1 (default 1).
# 1 takes about two minutes and matches the prototype's figures; 0.2 is what the tests use.
SEED_SCALE=

# Production only, for `npm run bootstrap` (README, Deploy checklist); the seed makes the demo's users and key.
# The Global user to create or keep. The password must be at least 8 characters and is never printed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Phoenix's API key. Leave it empty and the first bootstrap makes one and prints it once.
PHOENIX_CHANNEL_KEY=
